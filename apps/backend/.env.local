APP_NAME=movie-reco-backend
ENVIRONMENT=local
DEBUG=true
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg2://movie_user:movie_pass@localhost:5433/movie_reco_db

JWT_SECRET=local-dev-secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CF_RECS_PATH=/Users/tarunjain/Downloads/movie-recommendation/apps/backend/data/cf_top50_recommendations.csv
CONTENT_RECS_PATH=/Users/tarunjain/Downloads/movie-recommendation/apps/backend/data/final_movie_recommendations_mapped.csv

S3_ARTIFACTS_ENABLED=true
AWS_REGION=ap-southeast-2
S3_ARTIFACT_BUCKET=movie-reco-artifacts-tarun
S3_CF_RECS_KEY=artifacts/cf_top50_recommendations.csv
S3_CONTENT_RECS_KEY=artifacts/final_movie_recommendations_mapped.csv

CONTENT_REFRESH_MIN_FEEDBACK=3

CONTENT_WORKER_POLL_SECONDS=10
CONTENT_WORKER_BATCH_SIZE=5
CONTENT_RECS_TOP_K=50
CF_RETRAIN_MIN_FEEDBACK=3
CF_WORKER_POLL_SECONDS=30
CF_WORKER_BATCH_SIZE=1
NEUMF_GMF_EMB_SIZE=32
NEUMF_MLP_EMB_SIZE=32
NEUMF_EPOCHS=3
NEUMF_BATCH_SIZE=256
NEUMF_LR=0.001
NEUMF_NUM_TRAIN_NEGATIVES=4
NEUMF_NUM_EVAL_NEGATIVES=99
NEUMF_MIN_USER_POSITIVES=5
NEUMF_MIN_ITEM_POSITIVES=5
NEUMF_MAX_POSITIVE_ROWS=200000
NEUMF_RANDOM_STATE=42
CF_CANDIDATES_TOP_K=50

# Use this for testing first.
# Later set to 0 for all users.
CF_CANDIDATES_MAX_USERS=1000

CF_POSITIVE_RATING_THRESHOLD=4.0
CF_NEGATIVE_RATING_THRESHOLD=2.0
REDIS_URL=redis://localhost:6379/0
RECOMMENDATION_CACHE_TTL_SECONDS=3600
RECOMMENDATION_CACHE_ENABLED=true